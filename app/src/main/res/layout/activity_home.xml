<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top Logo -->

    <!-- Search Bar -->

    <ImageView
        android:id="@+id/logo"
        android:layout_width="74dp"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:contentDescription="App Logo"
        android:src="@drawable/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.089"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="295dp"
        android:layout_height="47dp"
        android:text="DREAMSTAYS"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@+id/logo"
        tools:layout_editor_absoluteY="45dp" />

    <EditText
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:hint="Search hotels, destinations..."
        android:padding="12dp"
        android:background="@drawable/search_background"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

    <!-- Scrollable Hotel Boxes -->
    <ScrollView
        android:id="@+id/scrollArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="12dp"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <!-- Hotel Box Template -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/box_background"
                android:layout_margin="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Hotel 1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/itc" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Luxury Hotel"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$120/night"
                    android:textSize="14sp"
                    android:textColor="@color/primaryDark"/>
            </LinearLayout>

            <!-- Box 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/box_background"
                android:layout_margin="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Hotel 2"
                    android:scaleType="centerCrop"
                    android:src="@drawable/beachh" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beach Resort"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$150/night"
                    android:textSize="14sp"
                    android:textColor="@color/primaryDark"/>
            </LinearLayout>

            <!-- Box 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/box_background"
                android:layout_margin="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Hotel 3"
                    android:scaleType="centerCrop"
                    android:src="@drawable/mirissa" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mountain Inn"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$90/night"
                    android:textSize="14sp"
                    android:textColor="@color/primaryDark"/>
            </LinearLayout>

            <!-- Box 4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/box_background"
                android:layout_margin="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
