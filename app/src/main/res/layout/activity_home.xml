                    android:layout_weight="1"
                    android:contentDescription="Hotel 4"
                    android:scaleType="centerCrop"
                    android:src="@drawable/shangrilah" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="City Hotel"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$110/night"
                    android:textSize="14sp"
                    android:textColor="@color/primaryDark"/>
            </LinearLayout>

            <!-- Box 5 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/box_background"
                android:layout_margin="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Hotel 5"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Countryside Lodge"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$80/night"
                    android:textSize="14sp"
                    android:textColor="@color/primaryDark"/>
            </LinearLayout>

            <!-- Box 6 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/box_background"
                android:layout_margin="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_weight="1"
                    android:contentDescription="Hotel 6"
                    android:scaleType="centerCrop"
                    android:src="@drawable/wadduwa2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lakeview Resort"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$130/night"
                    android:textSize="14sp"
                    android:textColor="@color/primaryDark"/>
            </LinearLayout>

            <!-- Box 7 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/box_background"
                android:layout_margin="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Hotel 7"
                    android:scaleType="centerCrop"
                    android:src="@drawable/villa1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desert Hotel"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$100/night"
                    android:textSize="14sp"
                    android:textColor="@color/primaryDark"/>
            </LinearLayout>

            <!-- Box 8 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/box_background"
                android:layout_margin="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Hotel 8"
                    android:scaleType="centerCrop"
                    android:src="@drawable/itc" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forest Retreat"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$95/night"
                    android:textSize="14sp"
                    android:textColor="@color/primaryDark"/>
            </LinearLayout>

            <!-- Row 5: Box 9 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/box_background"
                android:layout_margin="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Hotel 9"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ani_villa" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seaside Villa"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$140/night"
                    android:textSize="14sp"
                    android:textColor="@color/primaryDark"/>
            </LinearLayout>

            <!-- Box 10 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/box_background"
                android:layout_margin="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Hotel 10"
                    android:scaleType="centerCrop"
                    android:src="@drawable/beachh" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hilltop Inn"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$125/night"
                    android:textSize="14sp"
                    android:textColor="@color/primaryDark"/>
            </LinearLayout>

            <!-- Row 6: Box 11 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/box_background"
                android:layout_margin="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Hotel 11"
                    android:scaleType="centerCrop"
                    android:src="@drawable/galle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forest Lodge"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$110/night"
                    android:textSize="14sp"
                    android:textColor="@color/primaryDark"/>
            </LinearLayout>

            <!-- Box 12 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/box_background"
                android:layout_margin="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Hotel 12"
                    android:scaleType="centerCrop"
                    android:src="@drawable/dickwella" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sunset Retreat"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$135/night"
                    android:textSize="14sp"
                    android:textColor="@color/primaryDark"/>
            </LinearLayout>


        </GridLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="@color/primaryDark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:weightSum="4">

        <!-- Home -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_home"
                android:tint="@android:color/white"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@android:color/white"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Booking -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_booking"
                android:tint="@android:color/white"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Booking"
                android:textColor="@android:color/white"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Favorites -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_favorites"
                app:tint="@android:color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favorites"
                android:textColor="@android:color/white"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_profile"
                app:tint="@android:color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="@android:color/white"
                android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
